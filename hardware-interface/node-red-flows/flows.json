    {
        "id": "fad22d33b111e690",
        "type": "function",
        "z": "53c3d566fccacd92",
        "name": "function 4",
        "func": "// =========================================================\n// Helper Function: แปลงวินาทีรวม (150) -> รูปแบบ PLC (230)\n// =========================================================\nfunction calculateSeconds(payload) {\n    if (payload === undefined || payload === null) return null;\n    \n    // ถ้า Backend ส่งมาเป็น \"นาที:วินาที\" (เผื่อไว้)\n    let inputStr = String(payload);\n    if (inputStr.includes(\":\")) {\n        let parts = inputStr.split(\":\"); \n        let min = parseInt(parts[0]) || 0; \n        let sec = parseInt(parts[1]) || 0; \n        return (min * 60) + sec;\n    } \n    \n    // *** จุดที่แก้: ถ้าส่งมาเป็นตัวเลข (เช่น 150) ให้ใช้ได้เลย ไม่ต้องคูณ 60 แล้ว ***\n    return parseInt(payload);\n}\n\n// =========================================================\n// Main Logic: รับ JSON ก้อนเดียว แล้วแยกส่ง 5 ขา\n// =========================================================\n\n// รับข้อมูลที่ส่งมาจาก Backend (Topic: water/control/settings)\nvar data = msg.payload;\n\n// ตรวจสอบความถูกต้องของข้อมูลเบื้องต้น\nif (!data || typeof data !== 'object') return null;\n\n// เตรียมตัวแปรสำหรับส่งออกแต่ละขา (เริ่มด้วย null)\nvar outStart = null;      // ขา 1: Start Level\nvar outStop = null;       // ขา 2: Stop Level\nvar outDiff = null;       // ขา 3: Diff Level\nvar outCloseTime = null;  // ขา 4: Close Time\nvar outOpenTime = null;   // ขา 5: Open Time\n\n// --- 1. แยกค่า Start ---\nif (data.start !== undefined) {\n    outStart = { payload: parseInt(data.start) };\n}\n\n// --- 2. แยกค่า Stop ---\nif (data.stop !== undefined) {\n    outStop = { payload: parseInt(data.stop) };\n}\n\n// --- 3. แยกค่า Diff ---\nif (data.diff !== undefined) {\n    outDiff = { payload: parseInt(data.diff) };\n}\n\n// --- 4. แยกค่า Close Time (เข้าสูตรแปลงเป็น MMSS) ---\nif (data.close_time !== undefined) {\n    outCloseTime = { payload: calculateSeconds(data.close_time) };\n}\n\nif (data.open_time !== undefined) {\n    outOpenTime = { payload: calculateSeconds(data.open_time) };\n}\n\n// ส่งออก 5 ช่องพร้อมกัน ตามลำดับสายที่ลากไว้\nreturn [outStart, outStop, outDiff, outCloseTime, outOpenTime];",
