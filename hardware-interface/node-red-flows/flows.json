    {
        "id": "92c3ce29bf7dc0a1",
        "type": "function",
        "z": "53c3d566fccacd92",
        "name": "function 3",
        "func": "// 1. ดึงข้อมูลเก่าจากความจำมาเตรียมไว้\n// (ผมเปลี่ยนชื่อ Key ให้ตรงกับฐานข้อมูลเป๊ะๆ: road_val, canal_val)\nvar savedData = global.get('water_data') || { road_val: 0, canal_val: 0, q1_status: 0, q2_status: 0 };\n\n// 2. เช็คว่าข้อมูลที่เข้ามาคืออะไร? (Logic เดิมแต่เปลี่ยนชื่อตัวแปรรับค่า)\n\n// --- กรณีระดับน้ำ (Road/Canal) ---\nif (msg.payload.Road_Level !== undefined) savedData.road_val = msg.payload.Road_Level;\nif (msg.payload.Canal_Level !== undefined) savedData.canal_val = msg.payload.Canal_Level;\n\n// --- กรณีประตูน้ำ Q1 ---\nif (msg.topic === 'q1_status') {\n    savedData.q1_status = (msg.payload === true || msg.payload == 1) ? 1 : 0;\n}\n\n// --- กรณีประตูน้ำ Q2 ---\nif (msg.topic === 'q2_status') {\n    savedData.q2_status = (msg.payload === true || msg.payload == 1) ? 1 : 0;\n}\n\n// 3. บันทึกค่าล่าสุดกลับเข้าความจำ\nglobal.set('water_data', savedData);\n\n// 4. [สำคัญ] ส่งออกเป็น JSON Object (ไม่ต้องทำ SQL แล้ว)\n// Backend ของเราจะรับก้อนนี้ไปบันทึกลง DB ให้อัตโนมัติ\nmsg.payload = savedData;\n\n// ลบ msg.topic ทิ้ง เพื่อไม่ให้ไปกวน MQTT Topic ที่เราจะตั้งค่าใน Node ถัดไป\ndelete msg.topic; \n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
